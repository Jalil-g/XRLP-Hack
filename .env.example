# Copy to .env (gitignored). Repo is PUBLIC — never commit real values.
XRPL_NETWORK=devnet
XRPL_WS_URL=wss://s.devnet.rippletest.net:51233
XRPL_FAUCET_URL=https://faucet.devnet.rippletest.net/accounts
# Written by `pnpm --filter @xrlp/xrpl bootstrap` into .data/wallets.json (gitignored)
WALLETS_FILE=.data/wallets.json

# AI verifier: "mock" works with no key; "live" calls Claude
VERIFIER_MODE=mock
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
VERIFIER_MODEL=claude-opus-5-5

# core store
DATA_DIR=.data
