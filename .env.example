# Copy to .env (gitignored). Repo is PUBLIC — never commit real values.
XRPL_NETWORK=devnet
XRPL_WS_URL=wss://s.devnet.rippletest.net:51233
XRPL_FAUCET_URL=https://faucet.devnet.rippletest.net/accounts
# Written by `pnpm --filter @xrlp/xrpl bootstrap` into .data/wallets.json (gitignored)
WALLETS_FILE=.data/wallets.json

# AI verifier: "mock" works with no key; "live" calls Claude
VERIFIER_MODE=mock
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
VERIFIER_MODEL=claude-opus-5-5

# core store
DATA_DIR=.data

# core (packages/core) — v2
CORE_URL=http://localhost:4000          # apps rewrite /api/* here
LEDGER_MODE=fake                        # fake | devnet (devnet: run `pnpm --filter @xrlp/xrpl bootstrap` first, same WALLETS_FILE)
# CORE_VERIFIER=fake                    # fake | verifier (ClaudeVerifierAdapter). Unset: VERIFIER_MODE=live -> verifier, else fake
# DEMO_CANCEL_AFTER_S=1500,1800,420     # escrow CancelAfter per milestone, seconds after close (short devnet runs)
KEEPER=0                                # 1 = run keeperTick every 30s (expire -> cancel -> refund)
KEEPER_INTERVAL_MS=30000                 # keeper period when KEEPER=1 (>= 1000)
RELEASE_KEY=REPLACE_ME_32_BYTES_HEX     # 64 hex chars (openssl rand -hex 32); encrypts escrow preimages at rest. Placeholder/unset -> DATA_DIR/release-vault.key
# PORT=4000                             # core HTTP port
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# FAKE_LEDGER_DELAY_MS=0                # LEDGER_MODE=fake: simulated tx latency (rehearse stage pacing)
# ENV_FILE=/abs/path/.env               # core loads <repo>/.env by default; shell vars always win

# apps (apps/web, apps/inspector)
NEXT_PUBLIC_API_MODE=mock               # mock | http

# verifier provider (VER-14, stretch): anthropic | bedrock. Bedrock uses standard AWS creds.
VERIFIER_PROVIDER=anthropic
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=REPLACE_ME
# AWS_SECRET_ACCESS_KEY=REPLACE_ME

# packages/xrpl demo knobs (optional; defaults shown)
# DEMO_SPV_MODE=multisig          # multisig | single (fallback: SPV master key countersigns LoanSet, locked after)
# DEMO_WITHDRAW=0                 # 1 = wait for vault Redemption (~25 min) and do an investor VaultWithdraw
# DEMO_SUBSCRIPTION_S=60
# DEMO_PAYMENT_INTERVAL_S=300
# DEMO_M3_CANCEL_S=150
